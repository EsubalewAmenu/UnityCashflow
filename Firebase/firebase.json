{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true,
    "functions": {
      "port": 5001
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "cashflow",
      "runtime": "nodejs22",
      "predeploy": [
        "node --check \"$RESOURCE_DIR/index.js\"",
        "node --test \"$RESOURCE_DIR/room.test.js\""
      ],
      "ignore": [
        "node_modules",
        ".git",
        "*debug.log",
        "*.test.js"
      ]
    }
  ]
}
